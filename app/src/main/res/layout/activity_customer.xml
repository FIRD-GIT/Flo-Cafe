<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF9FC">

    <TextView
        android:id="@+id/customerHeaderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:text="@string/customer_page_title"
        android:textColor="#24202B"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/customerStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text="@string/customer_landing_message"
        android:textColor="#6B6673"
        android:importantForAccessibility="yes" />

    <FrameLayout
        android:id="@+id/customerContentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <LinearLayout
        android:id="@+id/customerBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/homeTabButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/tab_home"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/menuTabButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/tab_menu"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/basketTabButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/tab_basket"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/profileTabButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/tab_profile"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
