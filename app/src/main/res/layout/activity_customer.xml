<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF9FC">

    <TextView
        android:id="@+id/customerHeaderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:text="@string/customer_page_title"
        android:textColor="#24202B"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/customerStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text="@string/customer_landing_message"
        android:textColor="#6B6673"
        android:importantForAccessibility="yes" />

    <FrameLayout
        android:id="@+id/customerContentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/customerBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:menu="@menu/customer_bottom_navigation"
        app:itemIconTint="@color/customer_nav_selector"
        app:itemTextColor="@color/customer_nav_selector"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
