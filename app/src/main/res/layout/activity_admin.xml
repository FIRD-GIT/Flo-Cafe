<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_page_title"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adminStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/admin_landing_message" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/sign_out" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_analytics_heading"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adminAnalyticsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/admin_analytics_loading" />

            <EditText
                android:id="@+id/adminOrderSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:hint="@string/admin_order_search_hint"
                android:inputType="text" />

            <TextView
                android:id="@+id/adminOrdersText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_orders"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/orderActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

    <TextView
                android:id="@+id/adminReviewsHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_reviews_heading"
                android:textSize="20sp"
                android:textStyle="bold" />

    <TextView
                android:id="@+id/adminReviewsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_reviews" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
